{
  "name": "afriwidget",
  "version": "1.0.0",
  "description": "AfriWidget static site server with AI function proxy",
  "main": "server.js",
  "type": "module",
  "scripts": {
    "dev": "node server.js",
    "start": "node server.js",
    "lint": "node --check server.js generate-og-assets.js academic-progress.js",
    "validate:categories": "node validate-category-assignments.js",
    "prebuild": "npm run validate:categories",
    "build": "node generate-og-assets.js",
    "deploy": "npm run validate:categories && npx wrangler pages deploy ."
  },
  "dependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "compression": "^1.8.2",
    "express": "^4.21.2",
    "qrcode": "^1.5.4",
    "resend": "^6.19.0",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "autoprefixer": "^10.5.4",
    "postcss": "^8.5.26"
  }
}
